# Copia este archivo como .env (no lo subas a Git) o define estas variables en tu hosting.

# Cadena de conexión de Neon (Dashboard > Connect > Pooled connection). Incluye ?sslmode=require
DATABASE_URL=postgresql://usuario:clave@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Acceso del administrador (docente)
ADMIN_USER=docente
ADMIN_PASSWORD=cambia-esta-clave

# Texto largo aleatorio para firmar la sesión (por ejemplo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=cambia-este-secreto

PORT=3000
